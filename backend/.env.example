# Application
APP_NAME=Stock Intelligence API
ENVIRONMENT=development
API_PREFIX=/api

# Database
DATABASE_URL=postgresql+psycopg2://stock:stock@localhost:5432/stock_intelligence

# CORS (comma separated)
CORS_ORIGINS=http://localhost:5173

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Opportunity rule
OPP_LOOKBACK_DAYS=180
OPP_MIN_SAMPLE=3
OPP_DISCOUNT_THRESHOLD=0.15
